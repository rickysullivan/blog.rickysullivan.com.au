---
interface Props {
  title?: string;
}

const { title = "Further reading" } = Astro.props;
---

<aside class="editorial-further-reading" aria-labelledby="further-reading-heading">
  <h2 id="further-reading-heading">{title}</h2>
  <div class="editorial-further-reading__links"><slot /></div>
</aside>

<style>
  .editorial-further-reading {
    margin: 2.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.15rem 0;
  }

  .editorial-further-reading h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .editorial-further-reading__links :global(ul) {
    margin: 0.85rem 0 0;
  }
</style>
