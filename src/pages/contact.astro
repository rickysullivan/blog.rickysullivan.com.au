---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const instagram = siteConfig.socials.find((social) => social.label === "Instagram");
---

<BaseLayout title="Contact" description={`Contact ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Contact</p>
        <h1 class="pagehead-title">Say hello.</h1>
        <p class="pagehead-description">The easiest way to get in touch is a direct message.</p>
      </header>

      <div class="prose">
        {
          instagram ? (
            <p>
              <a href={instagram.href} rel="noreferrer" class="btn btn-outline">Message Ricky on Instagram</a>
            </p>
          ) : (
            <p>Contact details are being added.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
